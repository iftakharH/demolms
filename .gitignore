# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# local demo database (regenerated by the seed; the WAL sidecar files lock
# under a running dev server, which upsets file scanners)
/data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime uploads: `npm run seed` regenerates the seeded assets, and clicking
# through the app creates the rest. Keeping them out of the repo stops test runs
# and demo clicks from piling up in git history. The only uploads that cannot be
# rebuilt offline - the sample video, its poster and captions - stay tracked.
/public/uploads/avatars/*
/public/uploads/captions/*
/public/uploads/resources/*
/public/uploads/submissions/*
/public/uploads/thumbnails/*
/public/uploads/videos/*
!/public/uploads/videos/sample.mp4
!/public/uploads/videos/sample-poster.jpg
!/public/uploads/videos/sample.vtt
